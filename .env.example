# Copy this file to .env and fill in the values
# NEVER commit .env to GitHub

# Required for cloud deployment (Groq free API)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the LLM. Groq retires models periodically — when that happens
# every request fails with a 404 and you change this instead of the code.
# List what your key can access:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# Default: openai/gpt-oss-120b   Faster alternative: qwen/qwen3.8-27b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: protects the /stats usage endpoint
STATS_KEY=choose_a_random_string

# Ghanaian languages (Twi, Ga, Ewe, Dagbani, Fante, Frafra) via Ghana NLP's Khaya API.
# Sign up at https://developer.khaya.ai — the free tier is 100 calls per MONTH.
# Leave unset to run English-only; voice notes in English work either way (free, via Whisper).
# KHAYA_API_KEY=your_khaya_subscription_key
# KHAYA_MONTHLY_QUOTA=100

# Voice replies (Groq Orpheus TTS). English only, ~100 free requests, 200-char input cap —
# so the bot speaks a short summary and sends the full answer as text.
# An org admin must first accept the model terms at:
#   https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# TTS_ENABLED=true
# TTS_VOICE=Hannah          # Autumn, Diana, Hannah, Austin, Daniel, Troy
# TTS_MONTHLY_QUOTA=100

# Twilio credentials (from console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Telegram bot token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: set to 0.0.0.0 when running in Docker or on a server
# HOST=0.0.0.0
